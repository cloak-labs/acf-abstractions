{
  "name": "cloakwp/acf-abstractions",
  "description": "A set of OOP abstractions around ACF to improve developer experience.",
  "version": "0.0.23",
  "license": "LGPL-3.0-only",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.4",
    "composer/installers": "^2.2",
    "cloakwp/core": "^0.0",
    "vinkla/extended-acf": "dev-feat/v15-cloakwp-deltas as 15.1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../extended-acf",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "vcs",
      "url": "https://github.com/kaelansmith/extended-acf"
    }
  ],
  "autoload": {
    "psr-4": {
      "CloakWP\\ACF\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CloakWP\\ACF\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
